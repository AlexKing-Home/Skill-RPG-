{
  "name": "skill-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "assets:prepare": "node scripts/materialize-swamp-art.mjs",
    "dev": "npm run assets:prepare && vite",
    "build": "npm run assets:prepare && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run assets:prepare && node --test tests/*.test.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.1.1",
    "prettier": "3.6.2",
    "vite": "7.2.2"
  }
}
